class Solution {
    public int[] productExceptSelf(int[] nums) {

        int n = nums.length;
        int[] ans = new int[n];

        // Prefix product
        ans[0] = 1;

        for(int i = 1; i < n; i++) {
            ans[i] = ans[i - 1] * nums[i - 1];
        }

        // Suffix product
        int suffix = 1;

        for(int i = n - 1; i >= 0; i--) {

            // Current ans = left product × right product
            ans[i] = ans[i] * suffix;

            // Add current element to suffix
            suffix *= nums[i];
        }

        return ans;
    }
}