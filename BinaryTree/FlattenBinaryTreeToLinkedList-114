//we traverse using preorder but backwards, using recursive and nextRight pointer
//    1
//   /  \
//  2    5
// / \     \
//3   4     6

//output->>>>      1
//                /  \
//              null  2
//                     \
//                      3
//                       \
//                        4
//                         \
//                          5
//                           \
//                            6
// since we start building it backwards so we start from right, left instead of left, right

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    TreeNode nextRight = null;
    public void flatten(TreeNode root) {
        if(root == null){
            return;
        }

        flatten(root.right);
        flatten(root.left);

        root.left = null;
        root.right = nextRight;
        nextRight = root;
    }
}