/* Definition for Node
class Node {
    public int data;
    public Node left;
    public Node right;

    public Node(int val) {
        data = val;
        left = right = null;
    }
};
*/

class Solution {
    int ans = -1;
    
    public int kthAncestor(Node root, int k, int node) {
        solve(root, k, node);
        return ans;
    }
    
    int solve(Node root, int k, int node){
        if(root == null){
            return -1;
        }
        
        if(root.data == node){
            return 0;
        }
        
        int leftDist = solve(root.left, k, node);
        int rightDist = solve(root.right, k, node);
        
        if(leftDist == -1 && rightDist == -1){
            return -1; 
        }
        
        int dist = Math.max(leftDist, rightDist) + 1;
        
        if(dist == k){
            ans = root.data;
        }
        
        return dist;
    }
}