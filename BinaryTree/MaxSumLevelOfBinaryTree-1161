/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int maxLevelSum(TreeNode root) {
        Queue<TreeNode> q = new LinkedList<>();
        q.add(root);
        q.add(null);

        int level = 1;
        int ans = 1;
        int maxSum = Integer.MIN_VALUE;
        int sum = 0;

        while(!q.isEmpty()){
            TreeNode curr = q.remove();

            if(curr == null){
                if(sum > maxSum){
                    maxSum = sum;
                    ans = level;
                }

                if(q.isEmpty()){
                    break;
                }

                level++;
                sum = 0;
                q.add(null);
            }else{
                sum += curr.val;

                if(curr.left != null){
                    q.add(curr.left);
                }
                if(curr.right != null){
                    q.add(curr.right);
                }
            }
        }
        return ans;
    }
}