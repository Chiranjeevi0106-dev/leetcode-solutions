class Solution {
    public ArrayList<Integer> bellmanFord(int V, int[][] edges, int src) {
        int INF = 100000000;
        int dist[] = new int[V];
        for(int i = 0; i < dist.length; i++) {
            dist[i] = INF;
        }
        
        dist[src] = 0;
        
        for(int i = 0; i < V-1; i++) {
            for(int j = 0; j < edges.length; j++) {
                int u = edges[j][0];
                int v = edges[j][1];
                int wt = edges[j][2];
            
                if(dist[u] != INF && dist[u] + wt < dist[v]) {
                    dist[v] = dist[u] + wt;
                }
            }
        }
        
        for(int i = 0; i < edges.length; i++) {
            int u = edges[i][0];
            int v = edges[i][1];
            int wt = edges[i][2];
            
            if(dist[u] != INF && dist[u] + wt < dist[v]) {
                ArrayList<Integer> ans = new ArrayList<>();
                ans.add(-1);
                return ans;
            }
        }
        
        ArrayList<Integer> ans = new ArrayList<>();
        for(int i = 0; i < dist.length; i++) {
            ans.add(dist[i]);
        }
        
        return ans;
    }
}
