class Solution {
    public boolean isBipartite(int[][] graph) {
        int col[] = new int[graph.length];
        for(int i = 0; i < graph.length; i++) {
            col[i] = -1;
        }

        Queue<Integer> q = new LinkedList<>();
        for(int i = 0; i < graph.length; i++) {
            if(col[i] == -1) {
                col[i] = 0; //yellow
                q.add(i);
                while(!q.isEmpty()) {
                    int curr = q.remove();
                    for(int j = 0; j < graph[curr].length; j++) {
                        int next = graph[curr][j]; //neighbour
                        if(col[next] == -1) {
                            int newCol = col[curr] == 0 ? 1 : 0;
                            col[next] = newCol;
                            q.add(next);
                        }else if(col[next] == col[curr]) {
                            return false;
                        }
                    }
                }
            }
        }
        return true;
    }
}