class Solution {
    public void merge(int[] A, int m, int[] B, int n) {
        int idx = m+n-1, i=m-1, j=n-1;
        while(i>=0 && j>=0) {
            if(A[i] >= B[j]){
                A[idx] = A[i];
                idx--;
                i--;
            } else {
                A[idx] = B[j];
                idx--;
                j--;
            }      
        }
        while(j>=0) {
            A[idx] = B[j];
            idx--;
            j--;
        }
    }
}


//using heaps
class Solution {
    public void merge(int[] A, int m, int[] B, int n) {
        PriorityQueue<Integer> pq = new PriorityQueue<>();

        for(int i = 0; i < m; i++) {
            pq.add(A[i]);
        }

        for(int i = 0; i < n; i++) {
            pq.add(B[i]);
        }

        for(int i = 0; i < m + n; i++) {
            A[i] = pq.remove();
        }
    }
}

