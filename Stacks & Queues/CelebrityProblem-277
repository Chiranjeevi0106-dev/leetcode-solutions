class Solution {
    public int celebrity(int[][] arr) {
        int n = arr.length;

        Stack<Integer> s = new Stack<>();

        for(int i = 0; i < n; i++) {
            s.push(i);
        }

        while(s.size() > 1) {
            int i = s.pop();
            int j = s.pop();

            if(arr[i][j] == 0) {
                s.push(i);
            } else {
                s.push(j);
            }
        }

        int celeb = s.pop();
        for(int i = 0; i < n; i++) {
            if(i != celeb && (arr[celeb][i] == 1 || arr[i][celeb] == 0)) {
                return -1;
            }
        }
        return celeb;
    }
}