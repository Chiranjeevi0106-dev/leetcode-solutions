class MinStack {

    static class Pair {
        int val;
        int minVal;

        Pair(int val, int minVal) {
            this.val = val;
            this.minVal = minVal;
        }
    }

    Stack<Pair> s = new Stack<>();

    public MinStack() {
    }

    public void push(int val) {

        if (s.isEmpty()) {
            s.push(new Pair(val, val));
        } 
        else {
            int minVal = Math.min(val, s.peek().minVal);
            s.push(new Pair(val, minVal));
        }
    }

    public void pop() {
        s.pop();
    }

    public int top() {
        return s.peek().val;
    }

    public int getMin() {
        return s.peek().minVal;
    }
}

